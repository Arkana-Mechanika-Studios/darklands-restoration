<Project>
  <!-- The Workshop in a player's release for linux-x64, beside DarklandsRP in the same folder (its "run the game with this pack" starts it):
       one self-contained, compressed program with Avalonia's native libraries inside. dotnet publish src/Darklands.Workshop -p:PublishProfile=linux-x64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\linux-x64\</PublishDir>
  </PropertyGroup>
</Project>
