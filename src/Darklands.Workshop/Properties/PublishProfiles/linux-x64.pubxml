<Project>
  <!-- The Workshop in a player's release for linux-x64, a download of its own whose root is the Workshop folder (unzipped into the game's folder: DarklandsRP/Workshop, which finds DarklandsRP one folder up):
       one self-contained, compressed program with Avalonia's native libraries inside. dotnet publish src/Darklands.Workshop -p:PublishProfile=linux-x64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\workshop-linux-x64\Workshop\</PublishDir>
  </PropertyGroup>
</Project>
