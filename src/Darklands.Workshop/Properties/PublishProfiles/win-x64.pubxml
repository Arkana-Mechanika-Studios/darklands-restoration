<Project>
  <!-- The Workshop in a player's release for win-x64, a download of its own (put beside DarklandsRP, its "run the game with this pack" starts it):
       one self-contained, compressed program with Avalonia's native libraries inside. dotnet publish src/Darklands.Workshop -p:PublishProfile=win-x64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\workshop-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
