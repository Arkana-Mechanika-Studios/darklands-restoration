<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Darklands Workshop (decision 13): the modders' and translators' tools, Avalonia; its first editor the translators' text
       editor (Darklands.Workshop.Text). New code, outside the game: nothing references it, and the game never loads Avalonia. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DarklandsWorkshop</AssemblyName>
    <!-- the project's emblem with a gold quill on a red seal (the user's choice of three, 2026-11-21): the program's and the window's icon -->
    <ApplicationIcon>Assets\DarklandsWorkshop.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Darklands.Workshop.Text\Darklands.Workshop.Text.csproj" />
    <!-- a pack's fonts: the PNG reader and the TrueType rasteriser the game's hosts use -->
    <ProjectReference Include="..\Darklands.Rendering\Darklands.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Darklands.Workshop.Tests" />
  </ItemGroup>

  <!-- the project's branding on the start page: its emblem (the game's icon), the launcher's painting, rule and wordmark fonts
       (linked, one source with the launcher) -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\emblem.png" />
    <AvaloniaResource Include="Assets\Fonts\Inter-*.ttf" />
    <None Include="Assets\Fonts\Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="Inter-OFL.txt" />
    <AvaloniaResource Include="Assets\DarklandsWorkshop.ico" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\art\background.png" Link="Assets\banner.png" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\art\fleuron.png" Link="Assets\fleuron.png" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\art\rule-left.png" Link="Assets\rule-left.png" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\art\rule-right.png" Link="Assets\rule-right.png" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\Grenze-Black.ttf" Link="Assets\Fonts\Grenze-Black.ttf" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\GrenzeGotisch-Black.ttf" Link="Assets\Fonts\GrenzeGotisch-Black.ttf" />
  </ItemGroup>

  <!-- on Linux, the icon as a PNG beside the program, for the desktop menu's entry (install-desktop-entries beside DarklandsRP) -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))">
    <None Include="Assets\DarklandsWorkshop.png" Link="DarklandsWorkshop.png" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the translators' and modders' guides beside the Workshop (in a release: DarklandsRP/Workshop/docs), with the players' guides
       they link to (copies of the game's docs folder's, so their links hold in the Workshop's own download) -->
  <ItemGroup>
    <None Include="..\..\docs\LOCALISATION.md" Link="docs\LOCALISATION.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\docs\PACKS.md;..\..\docs\MODS.md;..\..\docs\SETTINGS.md;..\..\docs\REPORTING.md" Link="docs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\docs\modding\*.md" Link="docs\modding\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
