<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Darklands Workshop (decision 13): the modders' and translators' tools, Avalonia; its first editor the translators' text
       editor (Darklands.Workshop.Text). New code, outside the game: nothing references it, and the game never loads Avalonia. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DarklandsWorkshop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Darklands.Workshop.Text\Darklands.Workshop.Text.csproj" />
    <!-- a pack's fonts: the PNG reader and the TrueType rasteriser the game's hosts use -->
    <ProjectReference Include="..\Darklands.Rendering\Darklands.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Darklands.Workshop.Tests" />
  </ItemGroup>

  <!-- the project's branding on the start page: its emblem (the game's icon), the launcher's painting, rule and wordmark fonts
       (linked, one source with the launcher) -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\emblem.png" />
    <AvaloniaResource Include="..\Darklands.Host.Sdl\Resources\DarklandsRP.ico" Link="Assets\DarklandsRP.ico" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\art\background.png" Link="Assets\banner.png" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\art\fleuron.png" Link="Assets\fleuron.png" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\art\rule-left.png" Link="Assets\rule-left.png" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\art\rule-right.png" Link="Assets\rule-right.png" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\Grenze-Black.ttf" Link="Assets\Fonts\Grenze-Black.ttf" />
    <AvaloniaResource Include="..\Darklands.Launcher\Resources\GrenzeGotisch-Black.ttf" Link="Assets\Fonts\GrenzeGotisch-Black.ttf" />
  </ItemGroup>

</Project>
