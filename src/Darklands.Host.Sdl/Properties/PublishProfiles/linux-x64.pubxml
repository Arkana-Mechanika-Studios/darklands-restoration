<Project>
  <!-- A player's release for Linux x64 (also the Steam Deck): one self-contained, compressed program with libmt32emu.so
       and libSDL3.so.0 beside it (native libraries the program loads from its own folder first). The SDL3 is SDL 3.4.20 built
       on Ubuntu 22.04 (Native/linux-x64, tools/linux/build_sdl3.sh), so the game also runs where the system has no SDL3
       (Ubuntu 24.04 and older); deleting it makes the program use the system's libSDL3.so.0.
       dotnet publish src/Darklands.Host.Sdl -p:PublishProfile=linux-x64
       Publish on Linux (or pack with tar) so DarklandsRP keeps its executable bit; a zip made on Windows loses it (chmod +x DarklandsRP). -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- no .pdb files of the referenced projects beside the program -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\linux-x64\</PublishDir>
  </PropertyGroup>
</Project>
