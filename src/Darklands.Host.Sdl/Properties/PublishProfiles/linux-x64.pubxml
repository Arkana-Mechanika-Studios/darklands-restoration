<Project>
  <!-- A player's release for Linux x64 (also the Steam Deck): one self-contained, compressed program with libmt32emu.so
       beside it (a native library the program loads from its own folder). SDL2 is NOT shipped: every desktop distribution and
       SteamOS has libSDL2-2.0.so.0 (Debian/Ubuntu: libsdl2-2.0-0); a copy placed beside the program is used first.
       dotnet publish src/Darklands.Host.Sdl -p:PublishProfile=linux-x64
       Publish on Linux (or pack with tar) so DarklandsRP keeps its executable bit; a zip made on Windows loses it (chmod +x DarklandsRP). -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- no .pdb files of the referenced projects beside the program -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\linux-x64\</PublishDir>
  </PropertyGroup>
</Project>
