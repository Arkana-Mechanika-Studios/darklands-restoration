<Project>
  <!-- A player's release for Windows x64: one self-contained, compressed program with SDL2.dll and libmt32emu.dll
       beside it (native libraries the program loads from its own folder). dotnet publish src/Darklands.Host.Sdl -p:PublishProfile=win-x64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- no .pdb files of the referenced projects beside the program -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
