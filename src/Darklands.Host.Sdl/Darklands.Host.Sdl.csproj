<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Darklands.Platform\Darklands.Platform.csproj" />
    <ProjectReference Include="..\Darklands.Presentation\Darklands.Presentation.csproj" />
    <ProjectReference Include="..\Darklands.Rendering\Darklands.Rendering.csproj" />
    <ProjectReference Include="..\Darklands.Audio\Darklands.Audio.csproj" />
    <ProjectReference Include="..\Darklands.Audio.Mt32\Darklands.Audio.Mt32.csproj" />
    <ProjectReference Include="..\Darklands.DevConsole\Darklands.DevConsole.csproj" />
    <ProjectReference Include="..\Darklands.Launcher\Darklands.Launcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Darklands.Host.Sdl.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- the developer console's text (public domain renderer; DejaVu Sans Mono 2.37, see THIRD_PARTY_NOTICES.md) -->
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
    <EmbeddedResource Include="Resources/DejaVuSansMono.ttf" LogicalName="Darklands.Host.Sdl.DejaVuSansMono.ttf" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">
    <!-- SDL 2.32.10, the official Windows x64 release (zlib licence, see THIRD_PARTY_NOTICES.md), next to the program -->
    <None Include="Native/win-x64/SDL2.dll" Link="SDL2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- the program players start: DarklandsRP.exe, with the Darklands Restoration Project badge as its icon -->
    <AssemblyName>DarklandsRP</AssemblyName>
    <RootNamespace>Darklands.Host.Sdl</RootNamespace>
    <ApplicationIcon>Resources/DarklandsRP.ico</ApplicationIcon>
    <Product>Darklands Restoration Project</Product>
    <AssemblyTitle>Darklands Restoration Project</AssemblyTitle>
    <Company>Arkana Mechanika Studios</Company>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The commit the program is built from, as AssemblyMetadata("Commit", ...) for the problem reports (docs/REPORTING.md): GITHUB_SHA
       in CI, else the short commit from git (rev-parse); "unknown" without either (no git, or a source copy without the repository). The
       informational version stays free of it (Directory.Build.props). -->
  <Target Name="StampCommit" BeforeTargets="GetAssemblyAttributes;GenerateAssemblyInfo">
    <PropertyGroup>
      <StampedCommit Condition="'$(GITHUB_SHA)' != '' And $(GITHUB_SHA.Length) &gt;= 7">$(GITHUB_SHA.Substring(0, 7))</StampedCommit>
    </PropertyGroup>
    <Exec Condition="'$(StampedCommit)' == ''" Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitOutput" />
    </Exec>
    <PropertyGroup>
      <StampedCommit Condition="'$(StampedCommit)' == '' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(GitCommitOutput)', '^[0-9a-f]{7,40}$'))">$(GitCommitOutput)</StampedCommit>
      <StampedCommit Condition="'$(StampedCommit)' == ''">unknown</StampedCommit>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="Commit" Value="$(StampedCommit)" />
    </ItemGroup>
  </Target>

  <!-- this version's release notes (releases/<version>/release-notes.md beside the repository, when there) next to the program,
       for the launcher's "What's new"; without them the launcher links to the release's page -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\..\releases\$(Version)\release-notes.md" Link="RELEASE_NOTES.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\releases\$(Version)\release-notes.md')" />
  </ItemGroup>

  <!-- the pack makers' guide (docs/PACKS.md) and the example sound pack (packs/audio-pack-example, generated tones), beside the
       program in the build and in every release; the launcher offers the packs folder's packs -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\PACKS.md" Link="docs\PACKS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\audio-pack-example\**\*" Link="packs\audio-pack-example\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the mod makers' guide (docs/MODS.md) and the example mod (mods/wayside-shrine), beside the program in the build and in every
       release; a mod is played only when named (on the command line or in the settings file) -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\MODS.md" Link="docs\MODS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\mods\**\*" Link="mods\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the modding guides (docs/modding), the settings reference they link to and the localisation plan, beside the program in
       the build and in every release -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\modding\*.md" Link="docs\modding\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\SETTINGS.md" Link="docs\SETTINGS.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\LOCALISATION.md" Link="docs\LOCALISATION.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the guide to reporting a problem (docs/REPORTING.md), beside the program in the build and in every release -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\REPORTING.md" Link="docs\REPORTING.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- the licence and the third-party notices beside the program in the build and in every release -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- a release carries an empty MT32_ROMS folder beside the program, where the player puts MT-32 / CM-32L ROM files -->
  <Target Name="CreateMt32RomFolder" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)MT32_ROMS" />
  </Target>

  <!-- and a SOUNDFONT folder, where the launcher looks for a General MIDI SoundFont (.sf2) for the packs' .mid music; none is
       included (the launcher's SoundFont row says where to get a free one) -->
  <Target Name="CreateSoundFontFolder" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)SOUNDFONT" />
    <WriteLinesToFile File="$(PublishDir)SOUNDFONT\README.txt" Overwrite="true" Lines="Put a General MIDI SoundFont (.sf2 file) here: the packs' MIDI (.mid) music plays through it. Any General MIDI SoundFont you have works.;No SoundFont comes with the program. A free one: FluidR3_GM.sf2 by Frank Wen (MIT licence, about 140 MB):;search the web for &quot;FluidR3_GM sf2&quot;, or on Linux install the fluid-soundfont-gm package (it puts the file in /usr/share/sounds/sf2).;The first .sf2 here (by name) is used; the launcher's SoundFont row can choose another file. More: docs/PACKS.md." />
  </Target>

  <!-- the launcher as a program of its own beside DarklandsRP (Darklands.Host.Launcher): "DarklandsRP Launcher.exe" on Windows, the
       script DarklandsRP-Launcher on Linux. It starts DarklandsRP with its setup switch: the settings screen, whose Play starts the game. -->
  <Target Name="PublishLauncherProgram" AfterTargets="Publish">
    <PropertyGroup>
      <LauncherProject>$(MSBuildThisFileDirectory)..\Darklands.Host.Launcher\Darklands.Host.Launcher.csproj</LauncherProject>
      <LauncherForWindows Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))">true</LauncherForWindows>
    </PropertyGroup>
    <Exec Condition="'$(LauncherForWindows)' == 'true'" Command="dotnet build &quot;$(LauncherProject)&quot; -c Release -nologo -v q -o &quot;$(PublishDir).&quot;" />
    <Copy Condition="'$(LauncherForWindows)' != 'true'" SourceFiles="$(MSBuildThisFileDirectory)..\Darklands.Host.Launcher\linux\DarklandsRP-Launcher" DestinationFolder="$(PublishDir)" />
    <Exec Condition="'$(LauncherForWindows)' != 'true' and !$([MSBuild]::IsOSPlatform('Windows'))" Command="chmod +x &quot;$(PublishDir)DarklandsRP-Launcher&quot;" />
  </Target>

</Project>
