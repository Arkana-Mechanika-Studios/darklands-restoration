<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Workshop's translators' editor without its window (W-0 + E-text): a translation pack as texts to edit, read and written
       as plain .ftl files, checked by the game's own pack check. New code, outside the game: the game never references it. -->
  <ItemGroup>
    <ProjectReference Include="..\Darklands.Presentation\Darklands.Presentation.csproj" />
    <ProjectReference Include="..\Darklands.Localization\Darklands.Localization.csproj" />
    <ProjectReference Include="..\Darklands.Content\Darklands.Content.csproj" />
  </ItemGroup>

  <!-- the cards' titles in the list: the card scripts' class names in words (TextTitles; made by a developer's tool from src) -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\card-titles.json" LogicalName="Darklands.Workshop.Text.card-titles.json" />
  </ItemGroup>

  <!-- the Workshop's version and the oldest game it plays with (Directory.Build.props), read by WorkshopVersion -->
  <ItemGroup>
    <AssemblyMetadata Include="WorkshopVersion" Value="$(WorkshopVersion)" />
    <AssemblyMetadata Include="WorkshopNeedsGame" Value="$(WorkshopNeedsGame)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
