<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement graphics (HD packs) over the game's 320x200 screen, for any host. New code, outside the game. -->
  <ItemGroup>
    <ProjectReference Include="..\Darklands.Platform\Darklands.Platform.csproj" />
  </ItemGroup>

  <!-- a font pack's TrueType / OpenType fonts (TtfFont, L-6b set 2): the rasteriser the console and the launcher use already -->
  <ItemGroup>
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
