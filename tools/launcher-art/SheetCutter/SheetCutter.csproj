<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cuts the artist's launcher sheets into the launcher's pieces (see ../ASSETS.md and Program.cs). Not part of the solution:
       run it by hand on a folder of sheets, then Convert-LauncherArt.ps1 on that folder's "out". -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Darklands.Rendering/Darklands.Rendering.csproj" />
  </ItemGroup>

</Project>
